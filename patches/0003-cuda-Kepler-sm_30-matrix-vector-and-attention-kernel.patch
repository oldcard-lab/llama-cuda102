+
+static_assert(sizeof(block_iq3_xxs) == 98, "unexpected block_iq3_xxs size");
+
+// One lane's 8 weights (sub-block ib32, group l) of one IQ3_XXS block times y, scaled: returns dot8 * db.
+// All fields are 2-byte aligned in the 98-byte block, so only 16-bit loads (never widen these).
+static __device__ __forceinline__ float iq3_xxs_sb_dot8(
+        const char * block, const int ib32, const int l, const float4 * grid_f4, const float4 y1, const float4 y2) {
+    const uint16_t * halfwords = reinterpret_cast<const uint16_t *>(block);
+    const uint16_t q = halfwords[1 + 4 * ib32 + l];
+    const uint32_t aux = static_cast<uint32_t>(halfwords[33 + 2 * ib32])
+        | (static_cast<uint32_t>(halfwords[34 + 2 * ib32]) << 16);
+    half d_h;
+    memcpy(&d_h, halfwords, sizeof(d_h));
+    const float db = __half2float(d_h) * (0.5f + static_cast<float>(aux >> 28)) * 0.5f;
+    // sign byte = 7-bit index plus even parity in bit 7 (equals ksigns_iq2xs for all 128 values: probe)
+    const uint32_t s7 = (aux >> (7 * l)) & 127u;
+    const uint32_t signs = s7 | ((__popc(s7) & 1u) << 7);
+    const float4 g1 = grid_f4[q & 0xffu];
+    const float4 g2 = grid_f4[q >> 8];
+    // sign j applied by XOR into the float sign bit; s holds sign bit 7 at bit 31 and doubling it (IADD,
+    // 160/clk) brings the next lower sign bit to bit 31, instead of one 32/clk shift per weight
+    uint32_t s = signs << 24;
+    float dot = 0.0f;
+#define IQ3_SIGNED(g) __uint_as_float(__float_as_uint(g) ^ (s & 0x80000000u))
+    dot = fmaf(IQ3_SIGNED(g2.w), y2.w, dot); s += s;
+    dot = fmaf(IQ3_SIGNED(g2.z), y2.z, dot); s += s;
+    dot = fmaf(IQ3_SIGNED(g2.y), y2.y, dot); s += s;
+    dot = fmaf(IQ3_SIGNED(g2.x), y2.x, dot); s += s;
+    dot = fmaf(IQ3_SIGNED(g1.w), y1.w, dot); s += s;
+    dot = fmaf(IQ3_SIGNED(g1.z), y1.z, dot); s += s;
+    dot = fmaf(IQ3_SIGNED(g1.y), y1.y, dot); s += s;
+    dot = fmaf(IQ3_SIGNED(g1.x), y1.x, dot);
+#undef IQ3_SIGNED
+    return dot * db;
+}
+
+static __device__ __forceinline__ float iq3_xxs_g32_dot8(
+        const char * block, const int ib32, const int l, const uint32_t * grid_u32, const float4 y1, const float4 y2) {
+    const uint16_t * halfwords = reinterpret_cast<const uint16_t *>(block);
+    const uint16_t q = halfwords[1 + 4 * ib32 + l];
+    const uint32_t aux = static_cast<uint32_t>(halfwords[33 + 2 * ib32])
+        | (static_cast<uint32_t>(halfwords[34 + 2 * ib32]) << 16);
+    half d_h;
+    memcpy(&d_h, halfwords, sizeof(d_h));
+    const float db = __half2float(d_h) * (0.5f + static_cast<float>(aux >> 28)) * 0.5f;
+    const uint32_t s7 = (aux >> (7 * l)) & 127u;
+    const uint32_t signs = s7 | ((__popc(s7) & 1u) << 7);
+    const uint32_t g1u = grid_u32[q & 0xffu];
+    const uint32_t g2u = grid_u32[q >> 8];
+#define IQ3_G32_FLOAT(u) (__uint_as_float(0x4b000000u | ((u) & 0xffu)) - 8388608.0f)
+    const float4 g1 = make_float4(IQ3_G32_FLOAT(g1u), IQ3_G32_FLOAT(g1u >> 8), IQ3_G32_FLOAT(g1u >> 16), IQ3_G32_FLOAT(g1u >> 24));
+    const float4 g2 = make_float4(IQ3_G32_FLOAT(g2u), IQ3_G32_FLOAT(g2u >> 8), IQ3_G32_FLOAT(g2u >> 16), IQ3_G32_FLOAT(g2u >> 24));
+#undef IQ3_G32_FLOAT
+    uint32_t s = signs << 24;
+    float dot = 0.0f;
+#define IQ3_SIGNED(g) __uint_as_float(__float_as_uint(g) ^ (s & 0x80000000u))
+    dot = fmaf(IQ3_SIGNED(g2.w), y2.w, dot); s += s;
+    dot = fmaf(IQ3_SIGNED(g2.z), y2.z, dot); s += s;
+    dot = fmaf(IQ3_SIGNED(g2.y), y2.y, dot); s += s;
+    dot = fmaf(IQ3_SIGNED(g2.x), y2.x, dot); s += s;
+    dot = fmaf(IQ3_SIGNED(g1.w), y1.w, dot); s += s;
+    dot = fmaf(IQ3_SIGNED(g1.z), y1.z, dot); s += s;
+    dot = fmaf(IQ3_SIGNED(g1.y), y1.y, dot); s += s;
+    dot = fmaf(IQ3_SIGNED(g1.x), y1.x, dot);
+#undef IQ3_SIGNED
+    return dot * db;
+}
+
+template <int RPW, bool G32 = false>   // rows per warp; G32 = grid as uint32 + float-magic decode (r19)
+__launch_bounds__(128)
+static __global__ void mul_mat_vec_iq3_xxs_kepler(
+        const char * __restrict__ vx,
+        const float * __restrict__ vy,
+        float * __restrict__ dst,
+        const int nb,
+        const int nrows,
+        const int64_t stride_row_x,
+        const uint3 channel_ratio,
+        const int64_t stride_channel_x,
+        const int64_t stride_channel_y,
+        const int64_t stride_channel_dst,
+        const uint3 sample_ratio,
+        const int64_t stride_sample_x,
+        const int64_t stride_sample_y,
+        const int64_t stride_sample_dst) {
+    // grid table in shared memory. Staged with explicit indices: a `for (i = tid; i < 256; i += 128)` loop is
+    // miscompiled by this toolchain (clang-22 + ptxas 10.2, sm_30: the remainder trip count comes out as
+    // `ISUB R, R4, R4` = 0, so entries 128..255 were never written; probe: iq3-table-probe.cu, 2026-11-21).
+    // r16 (Neon review): the `sb` table is pre-expanded to float4 so the inner loop does no byte decode.
+    __shared__ float4 grid_f4[256];
+    __shared__ uint32_t grid_u32[256];
+    {
+        const int tid = threadIdx.y * WARP_SIZE + threadIdx.x;   // blockDim = (32, 4): launcher asserts it
+        if constexpr (G32) {
+            grid_u32[tid] = iq3xxs_grid[tid];
+            grid_u32[tid + 128] = iq3xxs_grid[tid + 128];
+        } else {
+            const uint32_t g0 = iq3xxs_grid[tid];
+            const uint32_t g1 = iq3xxs_grid[tid + 128];
+            grid_f4[tid]       = make_float4((float) (g0 & 0xffu), (float) ((g0 >> 8) & 0xffu), (float) ((g0 >> 16) & 0xffu), (float) (g0 >> 24));
+            grid_f4[tid + 128] = make_float4((float) (g1 & 0xffu), (float) ((g1 >> 8) & 0xffu), (float) ((g1 >> 16) & 0xffu), (float) (g1 >> 24));
+        }
+    }
+    __syncthreads();
+
+    const int lane = threadIdx.x;
+    const int ib32 = lane >> 2;
+    const int l = lane & 3;
+    // r16 (Grok/Muse review): two rows per warp, same lane map; each y float4 pair is loaded once and used by
+    // both rows, and the two rows' FMA chains are independent (the kernel was latency-bound, not decode-bound:
+    // removing the byte decode alone gave 0%).
+    const int row0 = blockIdx.x * (RPW * 4) + threadIdx.y * RPW;
+    const uint32_t channel_x = fastdiv(blockIdx.y, channel_ratio);
+    const uint32_t sample_x = fastdiv(blockIdx.z, sample_ratio);
+    const char * x_base = vx + sample_x * stride_sample_x * sizeof(block_iq3_xxs)
+        + channel_x * stride_channel_x * sizeof(block_iq3_xxs);
+    const float * y_base = vy + blockIdx.z * stride_sample_y + blockIdx.y * stride_channel_y;
+    float acc[RPW];
+    const char * row_x[RPW];
+    const int64_t row_bytes = stride_row_x * static_cast<int64_t>(sizeof(block_iq3_xxs));
+#pragma unroll
+    for (int r = 0; r < RPW; ++r) {
+        acc[r] = 0.0f;
+        // rows past the end read row0 (valid memory) and are never stored
+        row_x[r] = x_base + static_cast<int64_t>(row0 + (row0 + r < nrows ? r : 0)) * row_bytes;
+    }
+
+    if (row0 < nrows) {   // warp-uniform
+        for (int b = 0; b < nb; ++b) {
+            const int y_index = b * QK_K + 32 * ib32 + 8 * l;
+            const float4 y1 = *reinterpret_cast<const float4 *>(y_base + y_index);
+            const float4 y2 = *reinterpret_cast<const float4 *>(y_base + y_index + 4);
+#pragma unroll
+            for (int r = 0; r < RPW; ++r) {
+                if constexpr (G32) {
+                    acc[r] += iq3_xxs_g32_dot8(row_x[r] + b * sizeof(block_iq3_xxs), ib32, l, grid_u32, y1, y2);
+                } else {
+                    acc[r] += iq3_xxs_sb_dot8(row_x[r] + b * sizeof(block_iq3_xxs), ib32, l, grid_f4, y1, y2);
+                }
+            }
+        }
+    }
+
+#pragma unroll
+    for (int r = 0; r < RPW; ++r) {
+#pragma unroll
+        for (int offset = 16; offset > 0; offset >>= 1) {
+            acc[r] += __shfl_down_sync(0xffffffffu, acc[r], offset);
+        }
+    }
+    if (lane == 0) {
+        float * dst_base = dst + blockIdx.z * stride_sample_dst + blockIdx.y * stride_channel_dst;
+#pragma unroll
+        for (int r = 0; r < RPW; ++r) {
+            if (row0 + r < nrows) {
+                dst_base[row0 + r] = acc[r];
+            }
+        }
+    }
+}
+
+static void launch_mmvk_iq3_xxs_sb(
+        const char * src0_d, const float * src1_d, float * dst_d,
+        const int nb, const int nrows, const int64_t stride_row_x,
+        const uint3 channel_ratio, const int64_t stride_channel_x, const int64_t stride_channel_y, const int64_t stride_channel_dst,
+        const uint3 sample_ratio, const int64_t stride_sample_x, const int64_t stride_sample_y, const int64_t stride_sample_dst,
+        const int64_t ne2, const int64_t ne3, cudaStream_t stream) {
+    constexpr int WARPS_PER_BLOCK = 4;   // the kernel's grid staging assumes exactly 128 threads (32 x 4)
+    static_assert(WARPS_PER_BLOCK * WARP_SIZE == 128, "iq3_xxs sb stages its table with 128 threads");
+    const char * variant = ggml_cuda_kepler_mmv_iq3_variant();   // cached (r18)
+    // rows per warp: GGML_CUDA_KEPLER_MMV_IQ3_RPW = 1, 2 or 4 forces it; default 4, but 1 for short matrices
+    // (r16: 16x2048 takes 25 us at 1 row per warp vs 45 us at 4, which leaves the card one thread block)
+    static const int rpw_env = []() {
+        const char * env = std::getenv("GGML_CUDA_KEPLER_MMV_IQ3_RPW");
+        const int v = env ? std::atoi(env) : 0;
+        return (v == 1 || v == 2 || v == 4) ? v : 0;
+    }();
+    const int rpw = rpw_env ? rpw_env : (nrows < 256 ? 1 : 4);
+    const int rows_per_block = rpw * WARPS_PER_BLOCK;
+    const dim3 block_nums(static_cast<unsigned int>((static_cast<int64_t>(nrows) + rows_per_block - 1) / rows_per_block),
+        static_cast<unsigned int>(ne2), static_cast<unsigned int>(ne3));
+    const dim3 block_dims(WARP_SIZE, WARPS_PER_BLOCK, 1);
+    const ggml_cuda_kernel_launch_params launch_params(block_nums, block_dims, 0, stream);
+    const bool g32 = variant == nullptr || variant[0] == '\0' || std::strcmp(variant, "auto") == 0
+        || std::strcmp(variant, "g32") == 0;
+    if (g32) {
+        if (rpw == 1) {
+            ggml_cuda_kernel_launch(mul_mat_vec_iq3_xxs_kepler<1, true>, launch_params,
+                src0_d, src1_d, dst_d, nb, nrows, stride_row_x,
+                channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst,
+                sample_ratio, stride_sample_x, stride_sample_y, stride_sample_dst);
+        } else if (rpw == 2) {
+            ggml_cuda_kernel_launch(mul_mat_vec_iq3_xxs_kepler<2, true>, launch_params,
+                src0_d, src1_d, dst_d, nb, nrows, stride_row_x,
+                channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst,
+                sample_ratio, stride_sample_x, stride_sample_y, stride_sample_dst);
+        } else {
+            ggml_cuda_kernel_launch(mul_mat_vec_iq3_xxs_kepler<4, true>, launch_params,
+                src0_d, src1_d, dst_d, nb, nrows, stride_row_x,
+                channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst,
+                sample_ratio, stride_sample_x, stride_sample_y, stride_sample_dst);
+        }
+    } else if (rpw == 1) {
+        ggml_cuda_kernel_launch(mul_mat_vec_iq3_xxs_kepler<1>, launch_params,
+            src0_d, src1_d, dst_d, nb, nrows, stride_row_x,
+            channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst,
+            sample_ratio, stride_sample_x, stride_sample_y, stride_sample_dst);
+    } else if (rpw == 2) {
+        ggml_cuda_kernel_launch(mul_mat_vec_iq3_xxs_kepler<2>, launch_params,
+            src0_d, src1_d, dst_d, nb, nrows, stride_row_x,
+            channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst,
+            sample_ratio, stride_sample_x, stride_sample_y, stride_sample_dst);
+    } else {
+        ggml_cuda_kernel_launch(mul_mat_vec_iq3_xxs_kepler<4>, launch_params,
+            src0_d, src1_d, dst_d, nb, nrows, stride_row_x,
+            channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst,
+            sample_ratio, stride_sample_x, stride_sample_y, stride_sample_dst);
+    }
+}
+
+template <typename T>
+static __global__ void mul_mat_vec_kepler_attn_kq(
+        const T * x, const float * y, float * dst,
+        const int k, const int rows,
+        const int64_t nb00, const int64_t nb01, const int64_t nb02, const int64_t nb03,
+        const int64_t nb12, const int64_t nb13, const int64_t nb02_dst, const int64_t nb03_dst,
+        const int64_t dst_nb0, const int head_ratio, const int batch_ratio) {
+    __shared__ float query[256];
+    const int tid = threadIdx.x;
+    for (int i = tid; i < k; i += 128) {
+        const char * query_ptr = reinterpret_cast<const char *>(y)
+            + (int64_t) blockIdx.y * nb12 + (int64_t) blockIdx.z * nb13 + (int64_t) i * sizeof(float);
+        query[i] = *reinterpret_cast<const float *>(query_ptr);
+    }
+    __syncthreads();
+
+    const int lane = tid & 15;
+    const int row = blockIdx.x * 8 + tid / 16;
+    const int head = blockIdx.y;
+    const int batch = blockIdx.z;
+    float sum = 0.0f;
+    if (row < rows) {
+        const char * row_ptr = reinterpret_cast<const char *>(x)
+            + (int64_t) row * nb01 + (int64_t) (head / head_ratio) * nb02 + (int64_t) (batch / batch_ratio) * nb03;
+        for (int i = lane; i < k; i += 16) {
+            const T value = *reinterpret_cast<const T *>(row_ptr + (int64_t) i * nb00);
+            sum = fmaf(static_cast<float>(value), query[i], sum);
+        }
+    }
+    for (int offset = 8; offset > 0; offset >>= 1) {
+        sum += __shfl_down(sum, offset, 16);
+    }
+    if (lane == 0 && row < rows) {
+        char * out = reinterpret_cast<char *>(dst) + (int64_t) head * nb02_dst + (int64_t) batch * nb03_dst;
+        *reinterpret_cast<float *>(out + (int64_t) row * dst_nb0) = sum;
+    }
+}
+
+template <typename T>
+static __global__ void mul_mat_vec_kepler_attn_kqv(
+        const T * x, const float * y, float * dst,
+        const int k,
+        const int64_t nb00, const int64_t nb01, const int64_t nb02, const int64_t nb03,
+        const int64_t nb12, const int64_t nb13, const int64_t nb02_dst, const int64_t nb03_dst,
+        const int64_t dst_nb0, const int head_ratio, const int batch_ratio) {
+    __shared__ float partial[4];
+    const int tid = threadIdx.x;
+    const int warp = tid >> 5;
+    const int lane = tid & 31;
+    const int row = blockIdx.x;
+    const int head = blockIdx.y;
+    const int batch = blockIdx.z;
+    const char * x_head = reinterpret_cast<const char *>(x) + (int64_t) (head / head_ratio) * nb02 + (int64_t) (batch / batch_ratio) * nb03;
+    const float * q = reinterpret_cast<const float *>(reinterpret_cast<const char *>(y)
+        + (int64_t) head * nb12 + (int64_t) batch * nb13);
+    float sum = 0.0f;
+    for (int i = tid; i < k; i += 128) {
+        const T value = *reinterpret_cast<const T *>(x_head + (int64_t) i * nb00 + (int64_t) row * nb01);
+        sum = fmaf(static_cast<float>(value), q[i], sum);
+    }
+    for (int offset = 16; offset > 0; offset >>= 1) {
+        sum += __shfl_down(sum, offset);
+    }
+    if (lane == 0) {
+        partial[warp] = sum;
+    }
+    __syncthreads();
+    if (tid == 0) {
+        const float total = (partial[0] + partial[1]) + (partial[2] + partial[3]);
+        char * out = reinterpret_cast<char *>(dst) + (int64_t) head * nb02_dst + (int64_t) batch * nb03_dst;
+        *reinterpret_cast<float *>(out + (int64_t) row * dst_nb0) = total;
+    }
+}
+
+template <typename T>
+static __global__ void mul_mat_vec_kepler_attn_kqv_gqa2(
+        const T * x, const float * y, float * dst,
+        const int k,
+        const int64_t nb00, const int64_t nb01, const int64_t nb02, const int64_t nb03,
+        const int64_t nb12, const int64_t nb13, const int64_t nb02_dst, const int64_t nb03_dst,
+        const int64_t dst_nb0, const int batch_ratio) {
+    __shared__ float partial[2][4];
+    const int tid = threadIdx.x;
+    const int warp = tid >> 5;
+    const int lane = tid & 31;
+    const int row = blockIdx.x;
+    const int head0 = blockIdx.y * 2;
+    const int batch = blockIdx.z;
+    const char * x_head = reinterpret_cast<const char *>(x)
+        + (int64_t) blockIdx.y * nb02 + (int64_t) (batch / batch_ratio) * nb03;
+    const char * y_base = reinterpret_cast<const char *>(y) + (int64_t) batch * nb13;
+    const float * q0 = reinterpret_cast<const float *>(y_base + (int64_t) head0 * nb12);
+    const float * q1 = reinterpret_cast<const float *>(y_base + (int64_t) (head0 + 1) * nb12);
+    float sum0 = 0.0f;
+    float sum1 = 0.0f;
+    for (int i = tid; i < k; i += 128) {
+        const T value = *reinterpret_cast<const T *>(x_head + (int64_t) i * nb00 + (int64_t) row * nb01);
+        const float v = static_cast<float>(value);
+        sum0 = fmaf(v, q0[i], sum0);
+        sum1 = fmaf(v, q1[i], sum1);
+    }
+    for (int offset = 16; offset > 0; offset >>= 1) {
+        sum0 += __shfl_down(sum0, offset);
+        sum1 += __shfl_down(sum1, offset);
+    }
+    if (lane == 0) {
+        partial[0][warp] = sum0;
+        partial[1][warp] = sum1;
+    }
+    __syncthreads();
+    if (tid == 0) {
+        char * out = reinterpret_cast<char *>(dst) + (int64_t) batch * nb03_dst;
+        const float total0 = (partial[0][0] + partial[0][1]) + (partial[0][2] + partial[0][3]);
+        const float total1 = (partial[1][0] + partial[1][1]) + (partial[1][2] + partial[1][3]);
+        *reinterpret_cast<float *>(out + (int64_t) row * dst_nb0 + (int64_t) head0 * nb02_dst) = total0;
+        *reinterpret_cast<float *>(out + (int64_t) row * dst_nb0 + (int64_t) (head0 + 1) * nb02_dst) = total1;
+    }
+}
+
+static bool ggml_cuda_kepler_attn_enabled() {
+    static const bool enabled = []() {
+        const char * env = std::getenv("GGML_CUDA_KEPLER_ATTN");
+        if (env == nullptr) {
+            return true;
+        }
+        std::string value(env);
+        for (char & c : value) {
+            c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+        }
+        return !(value == "0" || value == "off" || value == "false" || value == "no");
+    }();
+    return enabled;
+}
+
+static bool ggml_cuda_mmvk_shape_supported(const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * dst) {
+    if (src0 == nullptr || src1 == nullptr || dst == nullptr) {
+        return false;
+    }
+    if (src0->type != GGML_TYPE_Q3_K && src0->type != GGML_TYPE_Q4_K && src0->type != GGML_TYPE_Q5_K && src0->type != GGML_TYPE_Q6_K && src0->type != GGML_TYPE_Q8_0 &&
+            src0->type != GGML_TYPE_Q5_0 && !(src0->type == GGML_TYPE_IQ3_XXS && ggml_cuda_kepler_mmv_iq3_enabled())) {
+        return false;
+    }
+    if (src1->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32) {
+        return false;
+    }
+
+    const int64_t ne00 = src0->ne[0];
+    const int64_t ne01 = src0->ne[1];
+    const int64_t ne02 = src0->ne[2];
+    const int64_t ne03 = src0->ne[3];
+
+    const int64_t ne10 = src1->ne[0];
+    const int64_t ne11 = src1->ne[1];
+    const int64_t ne12 = src1->ne[2];
+    const int64_t ne13 = src1->ne[3];
+
+    const int64_t ne0  = dst->ne[0];
+    const int64_t ne1  = dst->ne[1];
+    const int64_t ne2  = dst->ne[2];
+    const int64_t ne3  = dst->ne[3];
+
+    const bool q3_multi_column = src0->type == GGML_TYPE_Q3_K && ne11 >= 1 && ne11 <= 8 && ne1 == ne11;
+    if ((!q3_multi_column && (ne11 != 1 || ne1 != 1)) || ne10 != ne00 || ne0 != ne01 || ne2 != ne12 || ne3 != ne13) {
+        return false;
+    }
+    if (q3_multi_column && ne11 > 1 && (src1->nb[1] % 16) != 0) {
+        return false;
+    }
+    const int64_t block_size = ggml_blck_size(src0->type);
+    if (ne00 <= 0 || (ne00 % block_size) != 0 || ne01 <= 0 || ne02 <= 0 || ne03 <= 0 || ne2 <= 0 || ne3 <= 0) {
+        return false;
+    }
+    if ((ne2 % ne02) != 0 || (ne3 % ne03) != 0) {
+        return false;
+    }
+    // sm_30 gridDim.y and gridDim.z hardware limits
+    if (ne2 > 65535 || ne3 > 65535 || ne01 > INT32_MAX || ne00 > INT32_MAX) {
+        return false;
+    }
+
+    const size_t ts_src0 = ggml_type_size(src0->type);
+    const size_t ts_f32  = sizeof(float);
+
+    if (src0->nb[0] != ts_src0 || src1->nb[0] != ts_f32 || dst->nb[0] != ts_f32) {
+        return false;
+    }
+    if ((src0->nb[1] % ts_src0) != 0 || (src0->nb[2] % ts_src0) != 0 || (src0->nb[3] % ts_src0) != 0) {
+        return false;
+    }
+    if ((src1->nb[2] % ts_f32) != 0 || (src1->nb[3] % ts_f32) != 0) {
+        return false;
+    }
+    if ((dst->nb[2] % ts_f32) != 0 || (dst->nb[3] % ts_f32) != 0) {
+        return false;
+    }
+
+    // float4 loads on src1 require 16-byte alignment for base and active batch strides
+    if ((reinterpret_cast<uintptr_t>(src1->data) % 16) != 0) {
+        return false;
+    }
+    if ((ne12 > 1 && (src1->nb[2] % 16) != 0) || (ne13 > 1 && (src1->nb[3] % 16) != 0)) {
+        return false;
+    }
+
+    // Q4_K uses uint4 (16-byte aligned; sizeof(block_q4_K) == 144 is multiple of 16).
+    // Q3_K uses byte payload loads and a 2-byte-aligned scale; Q6_K, Q8_0 and Q5_0 use 2-byte-aligned block loads.
+    const size_t req_align_src0 = (src0->type == GGML_TYPE_Q4_K) ? 16 : 2;
+    if ((reinterpret_cast<uintptr_t>(src0->data) % req_align_src0) != 0) {
+        return false;
+    }
+
+    return true;
+}
+
+bool ggml_cuda_should_use_mmvk(const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * dst, int cc) {
+#if defined(GGML_USE_HIP) || defined(GGML_USE_MUSA)
+    GGML_UNUSED_VARS(src0, src1, dst, cc);
+    return false;
+#else
+    if (!GGML_CUDA_CC_IS_NVIDIA(cc) || cc < GGML_CUDA_CC_KEPLER || cc >= 500) {
+        return false;
+    }
+    if (src0 != nullptr && src0->type == GGML_TYPE_IQ3_XXS && !ggml_cuda_kepler_mmv_iq3_enabled()) {
+        mmvk_trace_stock(src0->type, "off", src0->ne[1], src0->ne[0]);
+        return false;
+    }
+    if (!ggml_cuda_kepler_mmv_enabled()) {
+        if (ggml_cuda_mmvk_shape_supported(src0, src1, dst)) {
+            mmvk_trace_stock(src0->type, "disabled", src0->ne[1], src0->ne[0]);
+        }
+        return false;
+    }
+    if (src0 != nullptr && src0->type == GGML_TYPE_Q3_K) {
+        const char * variant = ggml_cuda_kepler_mmv_q3k_variant();
+        if (variant != nullptr && std::strcmp(variant, "off") == 0) {
+            if (ggml_cuda_mmvk_shape_supported(src0, src1, dst)) {
+                mmvk_trace_stock(src0->type, "off", src0->ne[1], src0->ne[0]);
+            }
+            return false;
+        }
+    }
+    return ggml_cuda_mmvk_shape_supported(src0, src1, dst);
+#endif
+}
+
+bool ggml_cuda_mul_mat_vec_kepler(
+        ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst) {
+#if defined(GGML_USE_HIP) || defined(GGML_USE_MUSA)
+    GGML_UNUSED_VARS(ctx, src0, src1, dst);
+    return false;
+#else
+    // Exported entry point: re-check the device here too (not only in ggml_cuda_should_use_mmvk), so a
+    // new caller can never launch these sm_30 kernels on another architecture.
+    const int cc = ggml_cuda_info().devices[ctx.device].cc;
+    if (!GGML_CUDA_CC_IS_NVIDIA(cc) || cc < GGML_CUDA_CC_KEPLER || cc >= 500) {
+        return false;
+    }
+    if (!ggml_cuda_mmvk_shape_supported(src0, src1, dst)) {
+        return false;
+    }
+
+    const int block_size = ggml_blck_size(src0->type);
+    const int nb    = static_cast<int>(src0->ne[0] / block_size);
+    const int nrows = static_cast<int>(src0->ne[1]);
+
+    const size_t ts_src0 = ggml_type_size(src0->type);
+    const size_t ts_f32  = sizeof(float);
+
+    const int64_t stride_row_x       = static_cast<int64_t>(src0->nb[1] / ts_src0);
+    const int64_t stride_channel_x   = static_cast<int64_t>(src0->nb[2] / ts_src0);
+    const int64_t stride_sample_x    = static_cast<int64_t>(src0->nb[3] / ts_src0);
+
+    const int64_t stride_channel_y   = static_cast<int64_t>(src1->nb[2] / ts_f32);
+    const int64_t stride_column_y    = static_cast<int64_t>(src1->nb[1] / ts_f32);
+    const int64_t stride_sample_y    = static_cast<int64_t>(src1->nb[3] / ts_f32);
+
+    const int64_t stride_channel_dst = static_cast<int64_t>(dst->nb[2] / ts_f32);
+    const int64_t stride_column_dst  = static_cast<int64_t>(dst->nb[1] / ts_f32);
+    const int64_t stride_sample_dst  = static_cast<int64_t>(dst->nb[3] / ts_f32);
+
+    const uint3 channel_ratio = init_fastdiv_values(static_cast<uint64_t>(dst->ne[2] / src0->ne[2]));
+    const uint3 sample_ratio  = init_fastdiv_values(static_cast<uint64_t>(dst->ne[3] / src0->ne[3]));
+
+    const float * src1_d = static_cast<const float *>(src1->data);
+    float       * dst_d  = static_cast<float *>(dst->data);
+    cudaStream_t  stream = ctx.stream();
+
+    if (src0->type == GGML_TYPE_IQ3_XXS) {
+        const char * variant = ggml_cuda_kepler_mmv_iq3_variant();
+        const char * kernel = (variant == nullptr || variant[0] == '\0' || std::strcmp(variant, "auto") == 0 || std::strcmp(variant, "g32") == 0) ? "g32" : "sb";
+        mmvk_trace(src0->type, kernel, nrows, src0->ne[0]);
+        launch_mmvk_iq3_xxs_sb(
+            static_cast<const char *>(src0->data), src1_d, dst_d, nb, nrows, stride_row_x,
+            channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst,
+            sample_ratio, stride_sample_x, stride_sample_y, stride_sample_dst,
+            dst->ne[2], dst->ne[3], stream);
+        return true;
+    }
+
+    if (src0->type == GGML_TYPE_Q3_K) {
+        const block_q3_K * src0_d = static_cast<const block_q3_K *>(src0->data);
+        const char * variant = ggml_cuda_kepler_mmv_q3k_variant();
+        if (variant != nullptr && std::strcmp(variant, "off") == 0) {
+            return false;
+        }
+        if (src1->ne[1] > 1) {
+            // d32c<2> and d32o pick the load path per (row, block) from the address, so a 2-byte-offset view
+            // (mmvk-check off=1) is fine here; base addresses are always even (block_q3_K is 110 bytes)
+            for (int64_t col = 0; col < src1->ne[1];) {
+                const int remaining = static_cast<int>(src1->ne[1] - col);
+                const float * y_col = src1_d + col * stride_column_y;
+                float * dst_col = dst_d + col * stride_column_dst;
+                if (remaining >= 2) {
+                    // r24: auto = d32c4r4t (y through the texture cache, 4 rows x 2 columns, 74 us/col at
+                    // 2048x2048 vs d32c<2> 90); "d32c2" selects the plain global-y kernel, "d32c2t" the 2-row one
+                    const bool want_plain = variant != nullptr && std::strcmp(variant, "d32c2") == 0;
+                    const bool use_texture = !want_plain;
+                    bool launched_texture = false;
+                    if (use_texture) {
+                        const uint64_t extent_floats = static_cast<uint64_t>(dst->ne[3] - 1) * stride_sample_y
+                            + static_cast<uint64_t>(dst->ne[2] - 1) * stride_channel_y
+                            + static_cast<uint64_t>(2 - 1) * stride_column_y + static_cast<uint64_t>(nb) * QK_K;
+                        cudaTextureObject_t texture = 0;
+                        int y_off = 0;
+                        if (extent_floats <= SIZE_MAX / sizeof(float)
+                                && mmvk_q3k_texture(y_col, static_cast<size_t>(extent_floats) * sizeof(float), texture, y_off)) {
+                            if (variant == nullptr || std::strcmp(variant, "d32c2t") != 0) {
+                                launch_mmvk_q3_k_d32c4r4t(src0_d, y_col, dst_col, nb, nrows, stride_row_x,
+                                    stride_column_y, stride_column_dst, channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst,
+                                    sample_ratio, stride_sample_x, stride_sample_y, stride_sample_dst, dst->ne[2], dst->ne[3], stream,
+                                    texture, y_off);
+                            } else {
+                                launch_mmvk_q3_k_d32c<2, true>(src0_d, y_col, dst_col, nb, nrows, stride_row_x,
+                                    stride_column_y, stride_column_dst, channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst,
+                                    sample_ratio, stride_sample_x, stride_sample_y, stride_sample_dst, dst->ne[2], dst->ne[3], stream,
+                                    texture, y_off);
+                            }
+                            launched_texture = true;
+                        }
+                        if (!launched_texture && mmvk_trace_enabled()) {
+                            static std::atomic<bool> warned{false};
+                            if (!warned.exchange(true)) {
+                                std::fprintf(stderr, "KEPLER_TRACE type=Q3_K kernel=d32c2t-fallback\n");
+                            }
+                        }
+                    }
+                    if (!launched_texture) {
+                        launch_mmvk_q3_k_d32c<2>(src0_d, y_col, dst_col, nb, nrows, stride_row_x,
+                            stride_column_y, stride_column_dst, channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst,
+                            sample_ratio, stride_sample_x, stride_sample_y, stride_sample_dst, dst->ne[2], dst->ne[3], stream);
+                    }
+                    col += 2;
+                } else {
+                    launch_mmvk_q3_k_d32o(src0_d, y_col, dst_col, nb, nrows, stride_row_x,
+                        channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst,
+                        sample_ratio, stride_sample_x, stride_sample_y, stride_sample_dst, dst->ne[2], dst->ne[3], stream);
+                    ++col;
+                }
+            }
+            return true;
+        }
+        const bool q3_even_pairs_ok = ((nb & 1) == 0)
+            && ((stride_row_x & 1) == 0)
+            && ((reinterpret_cast<uintptr_t>(src0_d) & 3u) == 0u)
+            && (src0->ne[2] == 1 || (stride_channel_x & 1) == 0)
+            && (src0->ne[3] == 1 || (stride_sample_x & 1) == 0);
+        const bool q3_d32o_ok = nb >= 1 && ((reinterpret_cast<uintptr_t>(src0_d) & 3u) == 0u);
+        if (variant != nullptr && std::strcmp(variant, "d32s") == 0) {
+            if (q3_even_pairs_ok) {
+                launch_mmvk_q3_k_d32(
+                    src0_d, src1_d, dst_d, nb, nrows, stride_row_x,
+                    channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst,
+                    sample_ratio, stride_sample_x, stride_sample_y, stride_sample_dst,
+                    dst->ne[2], dst->ne[3], stream, true);
+            } else if (q3_d32o_ok) {
+                launch_mmvk_q3_k_d32o(
+                    src0_d, src1_d, dst_d, nb, nrows, stride_row_x,
+                    channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst,
+                    sample_ratio, stride_sample_x, stride_sample_y, stride_sample_dst,
+                    dst->ne[2], dst->ne[3], stream);
+            } else {
+                launch_mmvk_q3_k_pl2(
+                    src0_d, src1_d, dst_d, nb, nrows, stride_row_x,
+                    channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst,
+                    sample_ratio, stride_sample_x, stride_sample_y, stride_sample_dst,
+                    dst->ne[2], dst->ne[3], stream);
+            }
+            return true;
+        }
+        if (variant != nullptr && std::strcmp(variant, "d32o") == 0) {
+            if (q3_d32o_ok) {
+                launch_mmvk_q3_k_d32o(
+                    src0_d, src1_d, dst_d, nb, nrows, stride_row_x,
+                    channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst,
+                    sample_ratio, stride_sample_x, stride_sample_y, stride_sample_dst,
+                    dst->ne[2], dst->ne[3], stream);
+            } else {
+                launch_mmvk_q3_k_pl2(
+                    src0_d, src1_d, dst_d, nb, nrows, stride_row_x,
+                    channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst,
+                    sample_ratio, stride_sample_x, stride_sample_y, stride_sample_dst,
+                    dst->ne[2], dst->ne[3], stream);
+            }
+            return true;
+        }
+        if (variant != nullptr && std::strcmp(variant, "d32") == 0) {
+            if (q3_even_pairs_ok) {
+                launch_mmvk_q3_k_d32(
+                    src0_d, src1_d, dst_d, nb, nrows, stride_row_x,
+                    channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst,
+                    sample_ratio, stride_sample_x, stride_sample_y, stride_sample_dst,
+                    dst->ne[2], dst->ne[3], stream);
+            } else {
+                launch_mmvk_q3_k_pl2(
+                    src0_d, src1_d, dst_d, nb, nrows, stride_row_x,
+                    channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst,
+                    sample_ratio, stride_sample_x, stride_sample_y, stride_sample_dst,
+                    dst->ne[2], dst->ne[3], stream);
+            }
+            return true;
+        }
+        // the multi-column variant names select only the n > 1 path; n = 1 then behaves as "auto" (r24: selecting
+        // d32c4r4t used to send n = 1 to pl, halving Qwen3-1.7B decode in the test loop)
+        const bool q3_auto = variant == nullptr || std::strcmp(variant, "auto") == 0 || std::strcmp(variant, "d32c2") == 0
+            || std::strcmp(variant, "d32c2t") == 0 || std::strcmp(variant, "d32c4r4t") == 0;
+        if (q3_auto && q3_even_pairs_ok) {
+            launch_mmvk_q3_k_d32(
+                src0_d, src1_d, dst_d, nb, nrows, stride_row_x,
+                channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst,
+                sample_ratio, stride_sample_x, stride_sample_y, stride_sample_dst,
+                dst->ne[2], dst->ne[3], stream, true);
+        } else if (q3_auto && q3_d32o_ok) {
+            launch_mmvk_q3_k_d32o(
+                src0_d, src1_d, dst_d, nb, nrows, stride_row_x,
+                channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst,
+                sample_ratio, stride_sample_x, stride_sample_y, stride_sample_dst,
+                dst->ne[2], dst->ne[3], stream);
+        } else if ((variant == nullptr || std::strcmp(variant, "auto") == 0 || std::strcmp(variant, "v1") == 0) ||
+                std::strcmp(variant, "pl2") == 0) {
+            launch_mmvk_q3_k_pl2(
+                src0_d, src1_d, dst_d, nb, nrows, stride_row_x,
+                channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst,
+                sample_ratio, stride_sample_x, stride_sample_y, stride_sample_dst,
+                dst->ne[2], dst->ne[3], stream);
+        } else {
+            launch_mmvk_q3_k_pl(
+                src0_d, src1_d, dst_d, nb, nrows, stride_row_x,
+                channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst,
+                sample_ratio, stride_sample_x, stride_sample_y, stride_sample_dst,
+                dst->ne[2], dst->ne[3], stream);
+        }
+        return true;
+    }
+
+    if (src0->type == GGML_TYPE_Q4_K) {
+        const block_q4_K * src0_d = static_cast<const block_q4_K *>(src0->data);
+        const bool q4_sy_fits = static_cast<size_t>(nb) * (QK_K + 8) * sizeof(float) <= MMVK_SY_SMEM_LIMIT;
+        switch (ggml_cuda_kepler_mmv_q4k_variant()) {
+            case MMVK_Q4_K_SY:
+                if (q4_sy_fits) {
+                    launch_mmvk_q4_k_sy<16>(
+                        src0_d, src1_d, dst_d, nb, nrows, stride_row_x,
+                        channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst,
+                        sample_ratio,  stride_sample_x,  stride_sample_y,  stride_sample_dst,
+                        dst->ne[2], dst->ne[3], stream);
+                    break;
+                }
+                mmvk_warn_fallback_once("GGML_CUDA_KEPLER_MMV_Q4K", "sy", "vk2", nb);
+                launch_mmvk_q4_k_vk2(
+                    src0_d, src1_d, dst_d, nb, nrows, stride_row_x,
+                    channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst,
+                    sample_ratio,  stride_sample_x,  stride_sample_y,  stride_sample_dst,
+                    dst->ne[2], dst->ne[3], stream);
+                break;
+            case MMVK_Q4_K_AUTO:
+                // `sy` (y in shared memory) measured faster than vk2 for long rows (1024x4608, nb 18: 98.9 vs
+                // 109.7 us) and for 512x1024; slower for the other k = 1024 shapes and the 65536-row head.
+                if (q4_sy_fits && (nb >= 16 || (nb == 4 && nrows == 512))) {
+                    launch_mmvk_q4_k_sy<16>(
+                        src0_d, src1_d, dst_d, nb, nrows, stride_row_x,
+                        channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst,
+                        sample_ratio,  stride_sample_x,  stride_sample_y,  stride_sample_dst,
