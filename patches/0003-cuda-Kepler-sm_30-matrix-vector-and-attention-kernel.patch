+                src0_d, src1_d, dst_d, nb, nrows, stride_row_x,
+                channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst,
+                sample_ratio, stride_sample_x, stride_sample_y, stride_sample_dst,
+                dst->ne[2], dst->ne[3], stream);
+            return true;
+        }
+        if (std::strcmp(variant, "q5vk2r2") == 0) {
+            launch_mmvk_q5_k_vk2r2(
+                src0_d, src1_d, dst_d, nb, nrows, stride_row_x,
+                channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst,
+                sample_ratio, stride_sample_x, stride_sample_y, stride_sample_dst,
+                dst->ne[2], dst->ne[3], stream);
+            return true;
+        }
+        if (std::strcmp(variant, "q5vk2r4ys") == 0) {
+            launch_mmvk_q5_k_vk2r4ys(
+                src0_d, src1_d, dst_d, nb, nrows, stride_row_x,
+                channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst,
+                sample_ratio, stride_sample_x, stride_sample_y, stride_sample_dst,
+                dst->ne[2], dst->ne[3], stream);
+            return true;
+        }
+        if (std::strcmp(variant, "off") == 0) {
+            mmvk_trace_stock(src0->type, "off", src0->ne[1], src0->ne[0]);
+            return false;
+        }
+        GGML_LOG_WARN("%s: unknown GGML_CUDA_KEPLER_MMV_Q5K=\"%s\", using auto (valid: auto q5vk2 q5vk2r2 q5vk2r4ys off)\n", __func__, variant);
+        launch_mmvk_q5_k_vk2(
+            src0_d, src1_d, dst_d, nb, nrows, stride_row_x,
+            channel_ratio, stride_channel_x, stride_channel_y, stride_channel_dst,
+            sample_ratio, stride_sample_x, stride_sample_y, stride_sample_dst,
+            dst->ne[2], dst->ne[3], stream);
+        return true;
+    }
+
+    if (src0->type == GGML_TYPE_Q6_K) {
+        const block_q6_K * src0_d = static_cast<const block_q6_K *>(src0->data);
+        // Gate for the d32 kernel, which walks blocks in (even, odd) pairs: an even
+        // number of blocks per row, and row/channel/sample starts that keep the pairs 4-byte aligned.
+        // Shapes that fail it go to the `vk` kernel, which handles any nb.
+        const bool q6_even_pairs_ok = ((nb & 1) == 0)
+            && ((stride_row_x & 1) == 0)
+            && ((reinterpret_cast<uintptr_t>(src0_d) & 3u) == 0u)
+            && (src0->ne[2] == 1 || (stride_channel_x & 1) == 0)
+            && (src0->ne[3] == 1 || (stride_sample_x & 1) == 0);
+
+        switch (ggml_cuda_kepler_mmv_q6k_variant()) {
+            case MMVK_Q6_K_D32:
+            case MMVK_Q6_K_AUTO:
+            default:
