+    const float m1  = __fadd_rn(__uint_as_float(m_ff  & 0x47003F00u), -32768.0f);
+
+    d_sc0 = dm.x * sc0;
+    d_sc1 = dm.x * sc1;
+    d_m0  = -dm.y * m0;
+    d_m1  = -dm.y * m1;
