+    static std::set<int> printed;
+    std::lock_guard<std::mutex> lock(mutex);
+    if (printed.insert(static_cast<int>(type)).second) {
+        std::fprintf(stderr, "KEPLER_TRACE type=%s kernel=stock reason=%s m=%lld k=%lld\n",
+            ggml_type_name(type), reason, static_cast<long long>(m), static_cast<long long>(k));
