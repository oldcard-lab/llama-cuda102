diff --git a/ggml/src/ggml-cuda/mmgk.cu b/ggml/src/ggml-cuda/mmgk.cu
new file mode 100644
index 0000000..eb9fe9c
--- /dev/null
+++ b/ggml/src/ggml-cuda/mmgk.cu
@@ -0,0 +1,527 @@
+#include "mmgk.cuh"
+
+#include <cerrno>
+#include <climits>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <set>
+#include <string>
+#include <type_traits>
+
+static_assert(sizeof(block_q4_K) == 144, "unexpected block_q4_K size");
+static_assert(offsetof(block_q4_K, scales) == 4, "unexpected block_q4_K scales offset");
+static_assert(offsetof(block_q4_K, qs) == 16, "unexpected block_q4_K qs offset");
+static_assert(sizeof(block_q3_K) == 110, "unexpected block_q3_K size");
+static_assert(offsetof(block_q3_K, hmask) == 0, "unexpected block_q3_K hmask offset");
+static_assert(offsetof(block_q3_K, qs) == 32, "unexpected block_q3_K qs offset");
+static_assert(offsetof(block_q3_K, scales) == 96, "unexpected block_q3_K scales offset");
+static_assert(offsetof(block_q3_K, d) == 108, "unexpected block_q3_K d offset");
+static_assert(sizeof(block_q5_K) == 176, "unexpected block_q5_K size");
+static_assert(offsetof(block_q5_K, scales) == 4, "unexpected block_q5_K scales offset");
+static_assert(offsetof(block_q5_K, qh) == 16, "unexpected block_q5_K qh offset");
+static_assert(offsetof(block_q5_K, qs) == 48, "unexpected block_q5_K qs offset");
+static_assert(sizeof(block_q6_K) == 210, "unexpected block_q6_K size");
+static_assert(offsetof(block_q6_K, ql) == 0, "unexpected block_q6_K ql offset");
+static_assert(offsetof(block_q6_K, qh) == 128, "unexpected block_q6_K qh offset");
+static_assert(offsetof(block_q6_K, scales) == 192, "unexpected block_q6_K scales offset");
+static_assert(offsetof(block_q6_K, d) == 208, "unexpected block_q6_K d offset");
+static_assert(sizeof(block_q8_0) == 34, "unexpected block_q8_0 size");
+static_assert(offsetof(block_q8_0, d) == 0, "unexpected block_q8_0 d offset");
+static_assert(offsetof(block_q8_0, qs) == 2, "unexpected block_q8_0 qs offset");
+static_assert(sizeof(block_q4_0) == 18, "unexpected block_q4_0 size");
+static_assert(offsetof(block_q4_0, d) == 0, "unexpected block_q4_0 d offset");
+static_assert(offsetof(block_q4_0, qs) == 2, "unexpected block_q4_0 qs offset");
+static_assert(sizeof(block_q5_0) == 22, "unexpected block_q5_0 size");
+static_assert(offsetof(block_q5_0, d) == 0, "unexpected block_q5_0 d offset");
+static_assert(offsetof(block_q5_0, qh) == 2, "unexpected block_q5_0 qh offset");
+static_assert(offsetof(block_q5_0, qs) == 6, "unexpected block_q5_0 qs offset");
+
+const char * ggml_cuda_kepler_pp_mode() {
+    static const char * mode = []() {
+        const char * env = std::getenv("GGML_CUDA_KEPLER_PP");
+        if (env == nullptr || env[0] == '\0' || std::strcmp(env, "auto") == 0 || std::strcmp(env, "gemm") == 0 ||
+                std::strcmp(env, "cublas") == 0 || std::strcmp(env, "chunk") == 0 || std::strcmp(env, "pad") == 0 || std::strcmp(env, "off") == 0) {
+            return env == nullptr || env[0] == '\0' ? "auto" : env;
+        }
+        GGML_LOG_WARN("%s: unknown GGML_CUDA_KEPLER_PP=\"%s\", using auto\n", __func__, env);
+        return "auto";
+    }();
+    return mode;
+}
+
+#if !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA)
+
+static __device__ __forceinline__ float u_to_f32_fast(uint32_t q) {
+    return __fadd_rn(__uint_as_float(0x4b000000u | q), -8388608.0f);
+}
+
+static __device__ __forceinline__ void mmgk_get_scale_min_k4(int j, const uint8_t * q, uint8_t & d, uint8_t & m) {
+    if (j < 4) {
+        d = q[j] & 63;
+        m = q[j + 4] & 63;
+    } else {
+        d = (q[j + 4] & 0x0f) | ((q[j - 4] >> 6) << 4);
+        m = (q[j + 4] >> 4) | ((q[j] >> 6) << 4);
+    }
+}
+
+template<ggml_type type>
+static __device__ __forceinline__ float mmgk_dequant(const void * __restrict__ row, int kb, int lane);
+
+template<>
+__device__ __forceinline__ float mmgk_dequant<GGML_TYPE_Q4_K>(const void * __restrict__ row, int kb, int lane) {
+    const block_q4_K * blk = static_cast<const block_q4_K *>(row) + (kb >> 8);
+    const int group = (kb >> 5) & 7;
+    const int packed = (group >> 1) * 32 + lane;
+    uint8_t sc, mn;
+    mmgk_get_scale_min_k4(group, blk->scales, sc, mn);
+    half2 dm_h2;
+    memcpy(&dm_h2, &blk->dm, sizeof(dm_h2));
+    const float2 dm = __half22float2(dm_h2);
+    const uint8_t bv = blk->qs[packed];
+    const uint32_t q = (group & 1) ? (bv >> 4) : (bv & 0x0fu);
+    return (dm.x * u_to_f32_fast(sc)) * u_to_f32_fast(q) - (dm.y * u_to_f32_fast(mn));
+}
+
+template<>
+__device__ __forceinline__ float mmgk_dequant<GGML_TYPE_Q5_K>(const void * __restrict__ row, int kb, int lane) {
+    const block_q5_K * blk = static_cast<const block_q5_K *>(row) + (kb >> 8);
+    const int group = (kb >> 5) & 7;
+    const int packed = (group >> 1) * 32 + lane;
+    uint8_t sc, mn;
+    mmgk_get_scale_min_k4(group, blk->scales, sc, mn);
+    half2 dm_h2;
+    memcpy(&dm_h2, &blk->dm, sizeof(dm_h2));
+    const float2 dm = __half22float2(dm_h2);
+    const uint8_t bv = blk->qs[packed];
+    const uint32_t qlo = (group & 1) ? (bv >> 4) : (bv & 0x0fu);
+    const uint32_t qhi = ((blk->qh[lane] >> group) & 1u) << 4;
+    return (dm.x * u_to_f32_fast(sc)) * u_to_f32_fast(qlo | qhi) - (dm.y * u_to_f32_fast(mn));
+}
+
+template<>
+__device__ __forceinline__ float mmgk_dequant<GGML_TYPE_Q3_K>(const void * __restrict__ row, int kb, int lane) {
+    const block_q3_K * blk = static_cast<const block_q3_K *>(row) + (kb >> 8);
+    const int group = (kb >> 5) & 7;
+    const int n = group >> 2;
+    const int j = group & 3;
+    const int is = 2 * group + (lane >> 4);
+    const int us = is < 4 ? (blk->scales[is] & 0x0f) | (((blk->scales[is + 8] >> 0) & 3) << 4) :
+        is < 8 ? (blk->scales[is] & 0x0f) | (((blk->scales[is + 4] >> 2) & 3) << 4) :
+        is < 12 ? (blk->scales[is - 8] >> 4) | (((blk->scales[is] >> 4) & 3) << 4) :
+        (blk->scales[is - 8] >> 4) | (((blk->scales[is - 4] >> 6) & 3) << 4);
+    const float dl = __half2float(blk->d) * (u_to_f32_fast(static_cast<uint32_t>(us)) - 32.0f);
+    const int qlo = (blk->qs[32 * n + lane] >> (2 * j)) & 3;
+    const int hm_bit = (blk->hmask[lane] >> group) & 1;
+    return dl * static_cast<float>(qlo - (hm_bit ? 0 : 4));
+}
+
+template<>
+__device__ __forceinline__ float mmgk_dequant<GGML_TYPE_Q6_K>(const void * __restrict__ row, int kb, int lane) {
+    const block_q6_K * blk = static_cast<const block_q6_K *>(row) + (kb >> 8);
+    const int group = (kb >> 5) & 7;
+    const int ip = group >> 2;
+    const int sub = group & 3;
+    const uint8_t ql_byte = blk->ql[64 * ip + 32 * (sub & 1) + lane];
+    const uint32_t q4 = (sub & 2) ? (ql_byte >> 4) : (ql_byte & 0x0fu);
+    const uint32_t q2 = (blk->qh[32 * ip + lane] >> (2 * sub)) & 3u;
+    const float q = u_to_f32_fast(q4 | (q2 << 4)) - 32.0f;
+    const int8_t sc = blk->scales[8 * ip + 2 * sub + (lane >> 4)];
+    return (__half2float(blk->d) * static_cast<float>(sc)) * q;
+}
+
+template<>
+__device__ __forceinline__ float mmgk_dequant<GGML_TYPE_Q8_0>(const void * __restrict__ row, int kb, int lane) {
+    const block_q8_0 * blk = static_cast<const block_q8_0 *>(row) + (kb >> 5);
+    return __half2float(blk->d) * static_cast<float>(blk->qs[lane]);
+}
+
+template<>
+__device__ __forceinline__ float mmgk_dequant<GGML_TYPE_Q4_0>(const void * __restrict__ row, int kb, int lane) {
+    const block_q4_0 * blk = static_cast<const block_q4_0 *>(row) + (kb >> 5);
+    const uint8_t bv = blk->qs[lane & 15];
+    const uint32_t q = (lane & 16) ? (bv >> 4) : (bv & 0x0fu);
+    return __half2float(blk->d) * (u_to_f32_fast(q) - 8.0f);
+}
+
+template<>
+__device__ __forceinline__ float mmgk_dequant<GGML_TYPE_Q5_0>(const void * __restrict__ row, int kb, int lane) {
+    const block_q5_0 * blk = static_cast<const block_q5_0 *>(row) + (kb >> 5);
+    uint32_t qh;
+    memcpy(&qh, blk->qh, sizeof(qh));
+    const uint8_t bv = blk->qs[lane & 15];
+    const uint32_t q = ((lane & 16) ? (bv >> 4) : (bv & 0x0fu)) | (((qh >> lane) & 1u) << 4);
+    return __half2float(blk->d) * (u_to_f32_fast(q) - 16.0f);
+}
+
+template<ggml_type type, int N_TILE>
+__global__ __launch_bounds__(256, N_TILE == 8 ? 3 : 2)
+void mmgk_wide(const char * __restrict__ src0, const float * __restrict__ src1, float * __restrict__ dst, int M, int K, int N,
+        int64_t s01, int64_t s02, int64_t s03, int64_t s11, int64_t s12, int64_t s13,
+        int64_t s1, int64_t s2, int64_t s3, uint32_t ne2, uint32_t r2, uint32_t r3) {
+    __shared__ float sb[N_TILE][33];
+    const int tid = threadIdx.x;
+    const int warp_id = tid >> 5;
+    const int lane = tid & 31;
+    const int m = blockIdx.x * 8 + warp_id;
+    const int n_base = blockIdx.y * N_TILE;
+    const uint32_t z = blockIdx.z;
+    const uint32_t i3 = z / ne2;
+    const uint32_t i2 = z - i3 * ne2;
+    const uint32_t i02 = i2 / r2;
+    const uint32_t i03 = i3 / r3;
+    const char * src0_base = src0 + static_cast<int64_t>(i03) * s03 + static_cast<int64_t>(i02) * s02;
+    const float * src1_base = src1 + static_cast<int64_t>(i3) * s13 + static_cast<int64_t>(i2) * s12;
+    float * dst_base = dst + static_cast<int64_t>(i3) * s3 + static_cast<int64_t>(i2) * s2;
+    const char * row = m < M ? (src0_base + static_cast<int64_t>(m) * s01) : nullptr;
+    float acc[N_TILE] = {};
+
+    for (int kb = 0; kb < K; kb += 32) {
+        for (int j = warp_id; j < N_TILE; j += 8) {
+            const int gn = n_base + j;
+            sb[j][lane] = gn < N ? (src1_base + static_cast<int64_t>(gn) * s11)[kb + lane] : 0.0f;
+        }
+        __syncthreads();
+        if (m < M) {
+            const float a_val = mmgk_dequant<type>(row, kb, lane);
+            #pragma unroll
+            for (int j = 0; j < N_TILE; ++j) {
+                acc[j] = fmaf(a_val, sb[j][lane], acc[j]);
+            }
+        }
+        __syncthreads();
+    }
+
+    if (m < M) {
+        #pragma unroll
+        for (int j = 0; j < N_TILE; ++j) {
+            float v = acc[j];
+            #pragma unroll
+            for (int off = 16; off > 0; off >>= 1) {
+                v += __shfl_down_sync(0xffffffffu, v, off);
+            }
+            if (lane == 0 && n_base + j < N) {
+                (dst_base + static_cast<int64_t>(n_base + j) * s1)[m] = v;
+            }
+        }
+    }
+}
+
+template<ggml_type type>
+__global__ __launch_bounds__(256, 2)
+void mmgk_tiled64x32(const char * __restrict__ src0, const float * __restrict__ src1, float * __restrict__ dst, int M, int K, int N,
+        int64_t s01, int64_t s02, int64_t s03, int64_t s11, int64_t s12, int64_t s13,
+        int64_t s1, int64_t s2, int64_t s3, uint32_t ne2, uint32_t r2, uint32_t r3) {
+    __shared__ float sa[32][65];
+    __shared__ float sb[32][33];
+    const int tid = threadIdx.y * 16 + threadIdx.x;
+    const int tx = threadIdx.x;
+    const int ty = threadIdx.y;
+    const int warp_id = tid >> 5;
+    const int lane = tid & 31;
+    const int block_m = blockIdx.x * 64;
+    const int block_n = blockIdx.y * 32;
+    const uint32_t z = blockIdx.z;
+    const uint32_t i3 = z / ne2;
+    const uint32_t i2 = z - i3 * ne2;
+    const uint32_t i02 = i2 / r2;
+    const uint32_t i03 = i3 / r3;
+    const char * src0_base = src0 + static_cast<int64_t>(i03) * s03 + static_cast<int64_t>(i02) * s02;
+    const float * src1_base = src1 + static_cast<int64_t>(i3) * s13 + static_cast<int64_t>(i2) * s12;
+    float * dst_base = dst + static_cast<int64_t>(i3) * s3 + static_cast<int64_t>(i2) * s2;
+    float acc00 = 0.0f, acc01 = 0.0f, acc10 = 0.0f, acc11 = 0.0f;
+    float acc20 = 0.0f, acc21 = 0.0f, acc30 = 0.0f, acc31 = 0.0f;
+
+    for (int kb = 0; kb < K; kb += 32) {
+        #pragma unroll 1
+        for (int r = 0; r < 8; ++r) {
+            const int ml = warp_id + r * 8;
+            const int gm = block_m + ml;
+            float val = 0.0f;
+            if (gm < M) {
+                const char * row = src0_base + static_cast<int64_t>(gm) * s01;
+                val = mmgk_dequant<type>(row, kb, lane);
+            }
+            sa[lane][ml] = val;
+        }
+        #pragma unroll
+        for (int s = 0; s < 4; ++s) {
+            const int nl = warp_id + s * 8;
+            const int gn = block_n + nl;
+            sb[lane][nl] = gn < N ? (src1_base + static_cast<int64_t>(gn) * s11)[kb + lane] : 0.0f;
+        }
+        __syncthreads();
+
+        #pragma unroll
+        for (int kk = 0; kk < 32; ++kk) {
+            const float b0 = sb[kk][tx];
+            const float b1 = sb[kk][tx + 16];
+            const float a0 = sa[kk][ty];
+            const float a1 = sa[kk][ty + 16];
+            const float a2 = sa[kk][ty + 32];
+            const float a3 = sa[kk][ty + 48];
+            acc00 = fmaf(a0, b0, acc00); acc01 = fmaf(a0, b1, acc01);
+            acc10 = fmaf(a1, b0, acc10); acc11 = fmaf(a1, b1, acc11);
+            acc20 = fmaf(a2, b0, acc20); acc21 = fmaf(a2, b1, acc21);
+            acc30 = fmaf(a3, b0, acc30); acc31 = fmaf(a3, b1, acc31);
+        }
+        __syncthreads();
+    }
+
+    const int n0 = block_n + tx;
+    const int n1 = block_n + tx + 16;
+    const int m0 = block_m + ty;
+    const int m1 = block_m + ty + 16;
+    const int m2 = block_m + ty + 32;
+    const int m3 = block_m + ty + 48;
+    if (n0 < N) {
+        if (m0 < M) dst_base[static_cast<int64_t>(n0) * s1 + m0] = acc00;
+        if (m1 < M) dst_base[static_cast<int64_t>(n0) * s1 + m1] = acc10;
+        if (m2 < M) dst_base[static_cast<int64_t>(n0) * s1 + m2] = acc20;
+        if (m3 < M) dst_base[static_cast<int64_t>(n0) * s1 + m3] = acc30;
+    }
+    if (n1 < N) {
+        if (m0 < M) dst_base[static_cast<int64_t>(n1) * s1 + m0] = acc01;
+        if (m1 < M) dst_base[static_cast<int64_t>(n1) * s1 + m1] = acc11;
+        if (m2 < M) dst_base[static_cast<int64_t>(n1) * s1 + m2] = acc21;
+        if (m3 < M) dst_base[static_cast<int64_t>(n1) * s1 + m3] = acc31;
+    }
+}
+
+template<ggml_type type>
+__global__ __launch_bounds__(256, 2)
+void mmgk_tiled64x64(const char * __restrict__ src0, const float * __restrict__ src1, float * __restrict__ dst, int M, int K, int N,
+        int64_t s01, int64_t s02, int64_t s03, int64_t s11, int64_t s12, int64_t s13,
+        int64_t s1, int64_t s2, int64_t s3, uint32_t ne2, uint32_t r2, uint32_t r3) {
+    __shared__ __align__(16) float sa[32][68];
+    __shared__ __align__(16) float sb[32][68];
+    const int tid = threadIdx.y * 16 + threadIdx.x;
+    const int tx = threadIdx.x;
+    const int ty = threadIdx.y;
+    const int warp_id = tid >> 5;
+    const int lane = tid & 31;
+    const int block_m = blockIdx.x * 64;
+    const int block_n = blockIdx.y * 64;
+    const uint32_t z = blockIdx.z;
+    const uint32_t i3 = z / ne2;
+    const uint32_t i2 = z - i3 * ne2;
+    const uint32_t i02 = i2 / r2;
+    const uint32_t i03 = i3 / r3;
+    const char * src0_base = src0 + static_cast<int64_t>(i03) * s03 + static_cast<int64_t>(i02) * s02;
+    const float * src1_base = src1 + static_cast<int64_t>(i3) * s13 + static_cast<int64_t>(i2) * s12;
+    float * dst_base = dst + static_cast<int64_t>(i3) * s3 + static_cast<int64_t>(i2) * s2;
+    float c[4][4] = {};
+
+    for (int kb = 0; kb < K; kb += 32) {
+        #pragma unroll 2
+        for (int r = 0; r < 8; ++r) {
+            const int ml = warp_id + r * 8;
+            const int gm = block_m + ml;
+            float val = 0.0f;
+            if (gm < M) {
+                const char * row = src0_base + static_cast<int64_t>(gm) * s01;
+                val = mmgk_dequant<type>(row, kb, lane);
+            }
+            sa[lane][ml] = val;
+        }
+        #pragma unroll 2
+        for (int s = 0; s < 8; ++s) {
+            const int nl = warp_id + s * 8;
+            const int gn = block_n + nl;
+            sb[lane][nl] = gn < N ? (src1_base + static_cast<int64_t>(gn) * s11)[kb + lane] : 0.0f;
+        }
+        __syncthreads();
+
+        #pragma unroll 4
+        for (int kk = 0; kk < 32; ++kk) {
+            const float4 a = *reinterpret_cast<const float4 *>(&sa[kk][ty * 4]);
+            const float4 b = *reinterpret_cast<const float4 *>(&sb[kk][tx * 4]);
+            c[0][0] = fmaf(a.x, b.x, c[0][0]); c[0][1] = fmaf(a.x, b.y, c[0][1]);
+            c[0][2] = fmaf(a.x, b.z, c[0][2]); c[0][3] = fmaf(a.x, b.w, c[0][3]);
+            c[1][0] = fmaf(a.y, b.x, c[1][0]); c[1][1] = fmaf(a.y, b.y, c[1][1]);
+            c[1][2] = fmaf(a.y, b.z, c[1][2]); c[1][3] = fmaf(a.y, b.w, c[1][3]);
+            c[2][0] = fmaf(a.z, b.x, c[2][0]); c[2][1] = fmaf(a.z, b.y, c[2][1]);
+            c[2][2] = fmaf(a.z, b.z, c[2][2]); c[2][3] = fmaf(a.z, b.w, c[2][3]);
+            c[3][0] = fmaf(a.w, b.x, c[3][0]); c[3][1] = fmaf(a.w, b.y, c[3][1]);
+            c[3][2] = fmaf(a.w, b.z, c[3][2]); c[3][3] = fmaf(a.w, b.w, c[3][3]);
+        }
+        __syncthreads();
+    }
+
+    const int m_base = block_m + ty * 4;
+    const int n_base = block_n + tx * 4;
+    #pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        #pragma unroll
+        for (int j = 0; j < 4; ++j) {
+            if (m_base + i < M && n_base + j < N) {
+                dst_base[static_cast<int64_t>(n_base + j) * s1 + (m_base + i)] = c[i][j];
+            }
+        }
+    }
+}
+
+static bool ggml_cuda_mmgk_shape_supported(const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * dst) {
+    if (src0 == nullptr || src1 == nullptr || dst == nullptr || src0->data == nullptr || src1->data == nullptr || dst->data == nullptr) return false;
+    switch (src0->type) {
+        case GGML_TYPE_Q4_K: case GGML_TYPE_Q3_K: case GGML_TYPE_Q5_K: case GGML_TYPE_Q6_K:
+        case GGML_TYPE_Q8_0: case GGML_TYPE_Q4_0: case GGML_TYPE_Q5_0: break;
+        default: return false;
+    }
+    if (src1->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32) return false;
+    const int64_t ne00 = src0->ne[0], ne01 = src0->ne[1], ne02 = src0->ne[2], ne03 = src0->ne[3];
+    const int64_t ne10 = src1->ne[0], ne11 = src1->ne[1], ne12 = src1->ne[2], ne13 = src1->ne[3];
+    const int64_t ne0 = dst->ne[0], ne1 = dst->ne[1], ne2 = dst->ne[2], ne3 = dst->ne[3];
+    if (ne11 < 2 || ne1 != ne11 || ne10 != ne00 || ne0 != ne01 || ne2 != ne12 || ne3 != ne13) return false;
+    const int64_t block_size = ggml_blck_size(src0->type);
+    if (ne00 <= 0 || ne00 % block_size != 0 || ne00 % 32 != 0 || ne01 <= 0 || ne02 <= 0 || ne03 <= 0 || ne2 <= 0 || ne3 <= 0) return false;
+    if (ne00 > INT32_MAX - 32 || ne01 > INT32_MAX || ne11 > INT32_MAX || ne2 % ne02 != 0 || ne3 % ne03 != 0) return false;
+    if (ne2 > 65535 || ne3 > 65535 || ne2 > 65535 / ne3) return false;
+    if (ne11 > 32 && (ne11 + 63) / 64 > 65535) return false;
+    const size_t ts_src0 = ggml_type_size(src0->type);
+    const size_t ts_f32 = sizeof(float);
+    if (src0->nb[0] != ts_src0 || src0->nb[1] % ts_src0 != 0 || src0->nb[2] % ts_src0 != 0 || src0->nb[3] % ts_src0 != 0) return false;
+    if (src1->nb[0] != ts_f32 || src1->nb[1] % ts_f32 != 0 || src1->nb[2] % ts_f32 != 0 || src1->nb[3] % ts_f32 != 0) return false;
+    if (dst->nb[0] != ts_f32 || dst->nb[1] < static_cast<size_t>(ne0) * ts_f32 || dst->nb[1] % ts_f32 != 0 || dst->nb[2] % ts_f32 != 0 || dst->nb[3] % ts_f32 != 0) return false;
+    if ((ne2 > 1 && dst->nb[2] == 0) || (ne3 > 1 && dst->nb[3] == 0)) return false;
+    if (src0->nb[1] > INT64_MAX || src0->nb[2] > INT64_MAX || src0->nb[3] > INT64_MAX ||
+            src1->nb[1] > INT64_MAX || src1->nb[2] > INT64_MAX || src1->nb[3] > INT64_MAX ||
+            dst->nb[1] > INT64_MAX || dst->nb[2] > INT64_MAX || dst->nb[3] > INT64_MAX) return false;
+    const size_t req_align = src0->type == GGML_TYPE_Q4_K || src0->type == GGML_TYPE_Q5_K ? 4 : 2;
+    if (reinterpret_cast<uintptr_t>(src0->data) % req_align != 0 || reinterpret_cast<uintptr_t>(src1->data) % ts_f32 != 0 || reinterpret_cast<uintptr_t>(dst->data) % ts_f32 != 0) return false;
+    return true;
+}
+
+static int64_t mmgk_pp_max_n() {
+    static const int64_t max_n = []() {
+        const char * env = std::getenv("GGML_CUDA_KEPLER_PP_MAX_N");
+        if (env == nullptr || env[0] == '\0') return int64_t(32);
+        char * end = nullptr;
+        errno = 0;
+        const long long value = std::strtoll(env, &end, 10);
+        if (errno == ERANGE || end == env || *end != '\0' || value < 0) {
+            GGML_LOG_WARN("%s: invalid GGML_CUDA_KEPLER_PP_MAX_N=\"%s\", using 32\n", __func__, env);
+            return int64_t(32);
+        }
+        return static_cast<int64_t>(value);
+    }();
+    return max_n;
+}
+
+static void mmgk_trace(ggml_type type, const char * kernel, int64_t m, int64_t k, int64_t n) {
+    static const bool enabled = []() {
+        const char * env = std::getenv("GGML_CUDA_KEPLER_TRACE");
+        return env != nullptr && std::strcmp(env, "1") == 0;
+    }();
+    if (!enabled) return;
+    static std::mutex mutex;
+    static std::set<std::string> printed;
+    std::lock_guard<std::mutex> lock(mutex);
+    const std::string key = std::to_string(static_cast<int>(type)) + ":" + kernel + ":" +
+        std::to_string(m) + ":" + std::to_string(k) + ":" + std::to_string(n);
+    if (printed.insert(key).second) {
+        std::fprintf(stderr, "KEPLER_TRACE type=%s kernel=%s m=%lld k=%lld n=%lld\n", ggml_type_name(type), kernel,
+            static_cast<long long>(m), static_cast<long long>(k), static_cast<long long>(n));
+    }
+}
+
+bool ggml_cuda_should_use_mmgk(const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * dst, int cc) {
+#ifdef GGML_CUDA_FORCE_CUBLAS
+    GGML_UNUSED_VARS(src0, src1, dst, cc);
+    return false;
+#else
+    if (!GGML_CUDA_CC_IS_NVIDIA(cc) || cc < GGML_CUDA_CC_KEPLER || cc >= 500 || !ggml_cuda_mmgk_shape_supported(src0, src1, dst)) return false;
+    const char * mode = ggml_cuda_kepler_pp_mode();
+    if (std::strcmp(mode, "cublas") == 0 || std::strcmp(mode, "chunk") == 0 || std::strcmp(mode, "pad") == 0 || std::strcmp(mode, "off") == 0) return false;
+    const int64_t n = src1->ne[1];
+    return std::strcmp(mode, "gemm") == 0 || mmgk_pp_max_n() <= 0 || n <= mmgk_pp_max_n();
+#endif
+}
+
+bool ggml_cuda_mul_mat_kepler(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst) {
+#if defined(GGML_USE_HIP) || defined(GGML_USE_MUSA) || defined(GGML_CUDA_FORCE_CUBLAS)
+    GGML_UNUSED_VARS(ctx, src0, src1, dst);
+    return false;
+#else
+    const int cc = ggml_cuda_info().devices[ctx.device].cc;
+    if (!GGML_CUDA_CC_IS_NVIDIA(cc) || cc < GGML_CUDA_CC_KEPLER || cc >= 500 || !ggml_cuda_should_use_mmgk(src0, src1, dst, cc)) return false;
+    const int M = static_cast<int>(src0->ne[1]);
+    const int K = static_cast<int>(src0->ne[0]);
+    const int N = static_cast<int>(src1->ne[1]);
+    const int64_t s01 = static_cast<int64_t>(src0->nb[1]);
+    const int64_t s02 = static_cast<int64_t>(src0->nb[2]);
+    const int64_t s03 = static_cast<int64_t>(src0->nb[3]);
+    const int64_t s11 = static_cast<int64_t>(src1->nb[1] / sizeof(float));
+    const int64_t s12 = static_cast<int64_t>(src1->nb[2] / sizeof(float));
+    const int64_t s13 = static_cast<int64_t>(src1->nb[3] / sizeof(float));
+    const int64_t s1 = static_cast<int64_t>(dst->nb[1] / sizeof(float));
+    const int64_t s2 = static_cast<int64_t>(dst->nb[2] / sizeof(float));
+    const int64_t s3 = static_cast<int64_t>(dst->nb[3] / sizeof(float));
+    const uint32_t ne2 = static_cast<uint32_t>(src1->ne[2]);
+    const uint32_t r2 = static_cast<uint32_t>(src1->ne[2] / src0->ne[2]);
+    const uint32_t r3 = static_cast<uint32_t>(src1->ne[3] / src0->ne[3]);
+    const dim3 grid_wide(static_cast<unsigned int>((static_cast<int64_t>(M) + 7) / 8),
+        static_cast<unsigned int>((static_cast<int64_t>(N) + (N <= 8 ? 8 : 16) - 1) / (N <= 8 ? 8 : 16)),
+        static_cast<unsigned int>(src1->ne[2] * src1->ne[3]));
+    const dim3 grid_tiled32(static_cast<unsigned int>((static_cast<int64_t>(M) + 63) / 64),
+        static_cast<unsigned int>((static_cast<int64_t>(N) + 31) / 32), grid_wide.z);
+    const dim3 grid_tiled64(static_cast<unsigned int>((static_cast<int64_t>(M) + 63) / 64),
+        static_cast<unsigned int>((static_cast<int64_t>(N) + 63) / 64), grid_wide.z);
+    const dim3 block_tiled32(16, 16);
+    const dim3 block_tiled64(16, 16);
+    const char * src0_data = static_cast<const char *>(src0->data);
+    const float * src1_data = static_cast<const float *>(src1->data);
+    float * dst_data = static_cast<float *>(dst->data);
+    const auto launch = [&](auto type_tag) {
+        constexpr ggml_type type = decltype(type_tag)::value;
+        if (N <= 16) {
+            if (N <= 8) {
+                mmgk_wide<type, 8><<<grid_wide, 256, 0, ctx.stream()>>>(src0_data, src1_data, dst_data, M, K, N,
+                    s01, s02, s03, s11, s12, s13, s1, s2, s3, ne2, r2, r3);
+                mmgk_trace(type, "mmgk_wide8", M, K, N);
+            } else {
+                mmgk_wide<type, 16><<<grid_wide, 256, 0, ctx.stream()>>>(src0_data, src1_data, dst_data, M, K, N,
+                    s01, s02, s03, s11, s12, s13, s1, s2, s3, ne2, r2, r3);
+                mmgk_trace(type, "mmgk_wide16", M, K, N);
+            }
+        } else if (N <= 32) {
+            mmgk_tiled64x32<type><<<grid_tiled32, block_tiled32, 0, ctx.stream()>>>(src0_data, src1_data, dst_data, M, K, N,
+                s01, s02, s03, s11, s12, s13, s1, s2, s3, ne2, r2, r3);
+            mmgk_trace(type, "mmgk_tiled32", M, K, N);
+        } else {
+            mmgk_tiled64x64<type><<<grid_tiled64, block_tiled64, 0, ctx.stream()>>>(src0_data, src1_data, dst_data, M, K, N,
+                s01, s02, s03, s11, s12, s13, s1, s2, s3, ne2, r2, r3);
+            mmgk_trace(type, "mmgk_tiled64", M, K, N);
+        }
+    };
+    switch (src0->type) {
+        case GGML_TYPE_Q4_K: launch(std::integral_constant<ggml_type, GGML_TYPE_Q4_K>{}); break;
+        case GGML_TYPE_Q3_K: launch(std::integral_constant<ggml_type, GGML_TYPE_Q3_K>{}); break;
+        case GGML_TYPE_Q5_K: launch(std::integral_constant<ggml_type, GGML_TYPE_Q5_K>{}); break;
+        case GGML_TYPE_Q6_K: launch(std::integral_constant<ggml_type, GGML_TYPE_Q6_K>{}); break;
+        case GGML_TYPE_Q8_0: launch(std::integral_constant<ggml_type, GGML_TYPE_Q8_0>{}); break;
+        case GGML_TYPE_Q4_0: launch(std::integral_constant<ggml_type, GGML_TYPE_Q4_0>{}); break;
+        case GGML_TYPE_Q5_0: launch(std::integral_constant<ggml_type, GGML_TYPE_Q5_0>{}); break;
+        default: return false;
+    }
+    CUDA_CHECK(cudaGetLastError());
+    return true;
+#endif
+}
+
+#else
+
+bool ggml_cuda_should_use_mmgk(const ggml_tensor * src0, const ggml_tensor * src1, const ggml_tensor * dst, int cc) {
+    GGML_UNUSED_VARS(src0, src1, dst, cc);
+    return false;
+}
+
+bool ggml_cuda_mul_mat_kepler(ggml_backend_cuda_context & ctx, const ggml_tensor * src0, const ggml_tensor * src1, ggml_tensor * dst) {
+    GGML_UNUSED_VARS(ctx, src0, src1, dst);
+    return false;
+}
+
+#endif
