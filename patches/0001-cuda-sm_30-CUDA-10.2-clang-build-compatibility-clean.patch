diff --git a/ggml/src/ggml-cuda/vendors/cuda.h b/ggml/src/ggml-cuda/vendors/cuda.h
index 323c980..a32625b 100644
--- a/ggml/src/ggml-cuda/vendors/cuda.h
+++ b/ggml/src/ggml-cuda/vendors/cuda.h
@@ -3,9 +3,49 @@
 #include <cuda_runtime.h>
 #include <cuda.h>
 #include <cublas_v2.h>
-#include <cuda_bf16.h>
 #include <cuda_fp16.h>
 
+#if CUDART_VERSION >= 11000
+#include <cuda_bf16.h>
+#else
+struct nv_bfloat16 { unsigned short x; __host__ __device__ operator float() const; };
+struct nv_bfloat162 { nv_bfloat16 x; nv_bfloat16 y; };
+
+static __host__ __device__ __forceinline__ nv_bfloat16 __float2bfloat16(float x) {
+    union { half h; unsigned short u; } value;
+    value.h = __float2half(x);
+    return {value.u};
+}
+
+static __host__ __device__ __forceinline__ float __bfloat162float(nv_bfloat16 x) {
+    union { half h; unsigned short u; } value;
+    value.u = x.x;
+    return __half2float(value.h);
+}
+
+__host__ __device__ __forceinline__ nv_bfloat16::operator float() const {
+    return __bfloat162float(*this);
+}
+
+static __host__ __device__ __forceinline__ nv_bfloat162 __float22bfloat162_rn(float2 x) {
+    return {__float2bfloat16(x.x), __float2bfloat16(x.y)};
+}
+
+static __host__ __device__ __forceinline__ float2 __bfloat1622float2(nv_bfloat162 x) {
+    return make_float2(__bfloat162float(x.x), __bfloat162float(x.y));
+}
+
+static __host__ __device__ __forceinline__ nv_bfloat16 __low2bfloat16(nv_bfloat162 x) {
+    return x.x;
+}
+
+static __host__ __device__ __forceinline__ nv_bfloat16 __high2bfloat16(nv_bfloat162 x) {
+    return x.y;
+}
+
+#define CUDA_R_16BF CUDA_R_16F
+#endif // CUDART_VERSION >= 11000
+
 #ifdef GGML_USE_NCCL
 #include <nccl.h>
 #endif // GGML_USE_NCCL
