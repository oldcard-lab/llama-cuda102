Subject: [PATCH 4/5] cuda: Kepler im2col path (GGML_CUDA_KEPLER_IM2COL)

Adds the Kepler im2col path.
---
 ggml/src/ggml-cuda/im2col.cu | 156 +++++++++++++++++++++++++++++++++++
 1 file changed, 156 insertions(+)

diff --git a/ggml/src/ggml-cuda/im2col.cu b/ggml/src/ggml-cuda/im2col.cu
index f9ff6c7..fce4d59 100644
--- a/ggml/src/ggml-cuda/im2col.cu
+++ b/ggml/src/ggml-cuda/im2col.cu
@@ -1,9 +1,19 @@
 #include "im2col.cuh"
 #include "convert.cuh" // #if CUDART_VERSION > 8000 || !defined(CUDART_VERSION)
 
+#include <cstring>
+
 #define MAX_GRIDDIM_Y 65535
 #define MAX_GRIDDIM_Z 65535
 
+static const char * im2col_kepler_variant() {
+    static const char * variant = []() {
+        const char * env = std::getenv("GGML_CUDA_KEPLER_IM2COL");
+        return env == nullptr ? "auto" : env;
+    }();
+    return variant;
+}
