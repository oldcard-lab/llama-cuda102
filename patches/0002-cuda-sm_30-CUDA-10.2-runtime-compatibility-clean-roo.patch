From: kepler-llama <kepler-llama@localhost>
Date: Sun, 22 Nov 2026 22:31:36 -0600
Subject: [PATCH 2/5] cuda: sm_30 / CUDA 10.2 runtime compatibility (clean-room
 job B)

Per-matrix cublasSgemm where CUDA 10.2's batched GEMM Ex APIs need compute capability 5.0; strided K-quant and
IQ conversions to F32 for non-contiguous rows. test-backend-ops ALL on CUDA0: OK 14361, FAIL 0, 4 too big for
1 GB (same as the reference build); LFM2.5-350M Q4_K_M and Qwen3-0.6B Q8_0 generate correct text on the GPU.
Written by a Codex worker (gpt-6-luna) from test output and CUDA documentation only; see the provenance record.
---
 ggml/src/ggml-cuda/convert.cu   | 83 +++++++++++++++++++++++++++++++++
 ggml/src/ggml-cuda/ggml-cuda.cu | 20 +++++++-
 2 files changed, 102 insertions(+), 1 deletion(-)

diff --git a/ggml/src/ggml-cuda/convert.cu b/ggml/src/ggml-cuda/convert.cu
index 77fd288..2728476 100644
--- a/ggml/src/ggml-cuda/convert.cu
+++ b/ggml/src/ggml-cuda/convert.cu
@@ -307,6 +307,63 @@ static void dequantize_row_q4_K_cuda(const void * vx, dst_t * y, const int64_t k
     dequantize_block_q4_K<<<nb, 32, 0, stream>>>(vx, y);
 }
 
+template<ggml_type type, int qk, int threads>
+static __global__ void dequantize_block_k_nc(const void * __restrict__ vx, float * __restrict__ y,
+        const int64_t ne00, const int64_t ne01, const int64_t ne0203, const uint3 ne02,
+        const int64_t s01, const int64_t s02, const int64_t s03) {
+    const int64_t ib00 = blockIdx.x;
+    if (threadIdx.x >= threads) {
+        return;
+    }
+
+    for (int64_t i01 = blockIdx.y; i01 < ne01; i01 += gridDim.y) {
+        for (int64_t i0203 = blockIdx.z; i0203 < ne0203; i0203 += gridDim.z) {
+            const uint2 dm = fast_div_modulo((uint32_t)i0203, ne02);
+            const int64_t i02 = dm.y;
+            const int64_t i03 = dm.x;
+            const int64_t ib = i03*s03 + i02*s02 + i01*s01 + ib00;
+            const int64_t iy = (i0203*ne01 + i01)*ne00 + ib00*qk;
+            if constexpr (type == GGML_TYPE_Q2_K) {
+                dequantize_q2_K(vx, ib, y + iy, threadIdx.x);
+            } else if constexpr (type == GGML_TYPE_Q3_K) {
+                dequantize_q3_K(vx, ib, y + iy, threadIdx.x);
+            } else if constexpr (type == GGML_TYPE_Q4_K) {
+                dequantize_q4_K(vx, ib, y + iy, threadIdx.x);
+            } else if constexpr (type == GGML_TYPE_Q5_K) {
+                dequantize_q5_K(vx, ib, y + iy, threadIdx.x);
+            } else if constexpr (type == GGML_TYPE_Q6_K) {
+                dequantize_q6_K(vx, ib, y + iy, threadIdx.x);
+            } else if constexpr (type == GGML_TYPE_IQ2_XXS) {
+                dequantize_iq2_xxs(vx, ib, y + iy, threadIdx.x);
+            } else if constexpr (type == GGML_TYPE_IQ2_XS) {
+                dequantize_iq2_xs(vx, ib, y + iy, threadIdx.x);
+            } else if constexpr (type == GGML_TYPE_IQ2_S) {
+                dequantize_iq2_s(vx, ib, y + iy, threadIdx.x);
+            } else if constexpr (type == GGML_TYPE_IQ3_XXS) {
+                dequantize_iq3_xxs(vx, ib, y + iy, threadIdx.x);
+            } else if constexpr (type == GGML_TYPE_IQ3_S) {
+                dequantize_iq3_s(vx, ib, y + iy, threadIdx.x);
+            } else if constexpr (type == GGML_TYPE_IQ1_S) {
+                dequantize_iq1_s(vx, ib, y + iy, threadIdx.x);
+            } else if constexpr (type == GGML_TYPE_IQ1_M) {
+                dequantize_iq1_m(vx, ib, y + iy, threadIdx.x);
+            } else if constexpr (type == GGML_TYPE_IQ4_XS) {
+                dequantize_iq4_xs(vx, ib, y + iy, threadIdx.x);
+            }
+        }
+    }
+}
+
+template<ggml_type type, int qk, int threads>
+static void dequantize_row_k_nc_cuda(const void * vx, float * y,
+        const int64_t ne00, const int64_t ne01, const int64_t ne02, const int64_t ne03,
+        const int64_t s01, const int64_t s02, const int64_t s03, cudaStream_t stream) {
+    const int64_t ne0203 = ne02*ne03;
+    const uint3 ne02_fdv = init_fastdiv_values(ne02);
+    const dim3 num_blocks(ne00 / qk, (int)std::min(ne01, (int64_t)65535), (int)std::min(ne0203, (int64_t)65535));
+    dequantize_block_k_nc<type, qk, threads><<<num_blocks, threads, 0, stream>>>(vx, y, ne00, ne01, ne0203, ne02_fdv, s01, s02, s03);
+}
+
 template<typename dst_t>
 static void dequantize_row_q5_K_cuda(const void * vx, dst_t * y, const int64_t k, cudaStream_t stream) {
     const int nb = k / QK_K;
@@ -735,6 +792,32 @@ to_fp32_nc_cuda_t ggml_get_to_fp32_nc_cuda(ggml_type type) {
             return dequantize_block_cuda<QK5_1, QR5_1, dequantize_q5_1>;
         case GGML_TYPE_Q8_0:
             return dequantize_block_cuda<QK8_0, QR8_0, dequantize_q8_0>;
+        case GGML_TYPE_Q2_K:
+            return dequantize_row_k_nc_cuda<GGML_TYPE_Q2_K, QK_K, 64>;
+        case GGML_TYPE_Q3_K:
+            return dequantize_row_k_nc_cuda<GGML_TYPE_Q3_K, QK_K, 64>;
+        case GGML_TYPE_Q4_K:
+            return dequantize_row_k_nc_cuda<GGML_TYPE_Q4_K, QK_K, 32>;
+        case GGML_TYPE_Q5_K:
+            return dequantize_row_k_nc_cuda<GGML_TYPE_Q5_K, QK_K, 64>;
+        case GGML_TYPE_Q6_K:
+            return dequantize_row_k_nc_cuda<GGML_TYPE_Q6_K, QK_K, 64>;
+        case GGML_TYPE_IQ2_XXS:
+            return dequantize_row_k_nc_cuda<GGML_TYPE_IQ2_XXS, QK_K, 32>;
+        case GGML_TYPE_IQ2_XS:
+            return dequantize_row_k_nc_cuda<GGML_TYPE_IQ2_XS, QK_K, 32>;
+        case GGML_TYPE_IQ2_S:
+            return dequantize_row_k_nc_cuda<GGML_TYPE_IQ2_S, QK_K, 32>;
+        case GGML_TYPE_IQ3_XXS:
+            return dequantize_row_k_nc_cuda<GGML_TYPE_IQ3_XXS, QK_K, 32>;
+        case GGML_TYPE_IQ3_S:
+            return dequantize_row_k_nc_cuda<GGML_TYPE_IQ3_S, QK_K, 32>;
+        case GGML_TYPE_IQ1_S:
+            return dequantize_row_k_nc_cuda<GGML_TYPE_IQ1_S, QK_K, 32>;
+        case GGML_TYPE_IQ1_M:
+            return dequantize_row_k_nc_cuda<GGML_TYPE_IQ1_M, QK_K, 32>;
+        case GGML_TYPE_IQ4_XS:
+            return dequantize_row_k_nc_cuda<GGML_TYPE_IQ4_XS, QK_K, 32>;
         case GGML_TYPE_BF16:
             return convert_unary_cuda<nv_bfloat16, float>;
         default:
diff --git a/ggml/src/ggml-cuda/ggml-cuda.cu b/ggml/src/ggml-cuda/ggml-cuda.cu
